{
  "name": "astro66",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "bknd": "PROXY=1 bunx tsx node_modules/.bin/bknd",
    "bknd:typegen": "bun run bknd types",
    "bknd:sync": "bun run bknd -- sync --force --drop",
    "bknd:setup": "bun run bknd:typegen && bun run bknd:sync",
    "dev": "bun bknd:setup && wrangler types --env development && CLOUDFLARE_ENV=development astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.0.0-beta.3",
    "@astrojs/react": "^4.4.2",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.0.0-beta.6",
    "bknd": "^0.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "wrangler": "^4.61.1"
  }
}
