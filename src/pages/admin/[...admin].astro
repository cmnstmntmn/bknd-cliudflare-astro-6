---
import { Admin } from "bknd/ui";
import "bknd/dist/styles.css";

import { getApi } from "../../bknd.ts";

const api = await getApi(Astro, { system: false });
const user = api.getUser();
---

<html>
    <body>
        <Admin
            withProvider={{ user }}
            config={{
                basepath: "/admin",
                logo_return_path: "/../",
            }}
            client:only
        />
    </body>
</html>
